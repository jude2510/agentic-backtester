# Local development (npm run dev). Copy to .env.local.
#
# The API routes use the deployed DynamoDB tables and worker Lambda with your
# AWS credentials (export AWS_PROFILE=...). Model calls happen in the worker,
# so the frontend needs no agent ARN.
AWS_REGION=us-east-1

# Skip the usage caps while developing. Leave unset in production.
QUOTA_ENFORCED=false
